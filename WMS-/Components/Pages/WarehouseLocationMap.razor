@page "/warehouse-location-map"

<div class="space-y-gutter">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="font-display-lg text-display-lg text-on-background">Location Management</h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant mt-1">Zone A - Active Fulfillment</p>
        </div>
        <div class="flex items-center gap-3">
            <!-- Legend -->
            <div class="hidden lg:flex items-center gap-2 px-4 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg shadow-sm">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase mr-2">Capacity:</span>
                <div class="w-4 h-4 rounded bg-[#d1fae5] border border-[#34d399]" title="0-20%"></div>
                <div class="w-4 h-4 rounded bg-[#a7f3d0] border border-[#10b981]" title="21-40%"></div>
                <div class="w-4 h-4 rounded bg-[#bfdbfe] border border-[#60a5fa]" title="41-60%"></div>
                <div class="w-4 h-4 rounded bg-[#93c5fd] border border-[#3b82f6]" title="61-80%"></div>
                <div class="w-4 h-4 rounded bg-[#1d4ed8] border border-[#1e40af]" title="81-100%"></div>
            </div>
        </div>
    </div>

    <!-- Main Layout: Grid + Sidebar -->
    <div class="flex flex-col xl:flex-row gap-gutter">
        <!-- Warehouse Map / Heatmap -->
        <div class="flex-1 bg-surface-container-lowest border border-outline-variant rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] flex flex-col overflow-hidden relative">
            <!-- Controls Bar -->
            <div class="p-4 border-b border-outline-variant bg-surface flex justify-between items-center z-10">
                <div class="flex gap-2">
                    <button class="px-3 py-1.5 bg-primary-container text-on-primary rounded-md font-label-md text-label-md hover:bg-primary transition-colors">Zone A</button>
                    <button class="px-3 py-1.5 bg-surface text-on-surface border border-outline-variant rounded-md font-label-md text-label-md hover:bg-surface-container transition-colors">Zone B</button>
                    <button class="px-3 py-1.5 bg-surface text-on-surface border border-outline-variant rounded-md font-label-md text-label-md hover:bg-surface-container transition-colors">Bulk Storage</button>
                </div>
                <div class="flex gap-2">
                    <button class="p-1.5 text-on-surface-variant border border-outline-variant rounded-md hover:bg-surface-container transition-colors" title="Zoom In">
                        <span class="material-symbols-outlined text-[18px]">zoom_in</span>
                    </button>
                    <button class="p-1.5 text-on-surface-variant border border-outline-variant rounded-md hover:bg-surface-container transition-colors" title="Zoom Out">
                        <span class="material-symbols-outlined text-[18px]">zoom_out</span>
                    </button>
                </div>
            </div>
            <!-- Interactive Grid Area -->
            <div class="flex-1 p-8 overflow-auto bg-[#f8fafc] relative min-h-[400px]">
                <!-- Aisle A -->
                <div class="mb-12">
                    <h3 class="font-label-md text-label-md text-on-surface-variant mb-4 uppercase tracking-widest text-center border-b border-dashed border-outline-variant pb-2">Aisle A</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-5 md:grid-cols-10 gap-3">
                        <button class="h-20 rounded-md flex flex-col items-center justify-center cursor-pointer transition-all hover:scale-105 hover:shadow-md bg-[#d1fae5] border border-[#34d399] text-[#065f46]">
                            <span class="font-headline-md font-bold">A1</span>
                            <span class="font-label-md text-[10px] opacity-80">12%</span>
                        </button>
                        <button class="h-20 rounded-md flex flex-col items-center justify-center cursor-pointer transition-all hover:scale-105 hover:shadow-md bg-[#a7f3d0] border border-[#10b981] text-[#064e3b]">
                            <span class="font-headline-md font-bold">A2</span>
                            <span class="font-label-md text-[10px] opacity-80">35%</span>
                        </button>
                        <button class="h-20 rounded-md flex flex-col items-center justify-center cursor-pointer transition-all hover:scale-105 hover:shadow-md bg-[#1d4ed8] border border-[#1e40af] text-white ring-2 ring-primary ring-offset-2 outline-2 outline-[#004ac6]">
                            <span class="font-headline-md font-bold">A3</span>
                            <span class="font-label-md text-[10px] opacity-80">85%</span>
                        </button>
                        <!-- Add more buttons as needed to fill the grid -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Detail Sidebar -->
        <aside class="w-full xl:w-96 bg-surface-container-lowest border border-outline-variant rounded-xl shadow-[0_10px_20px_rgba(0,0,0,0.1)] flex flex-col h-auto">
            <!-- Header -->
            <div class="p-6 border-b border-outline-variant bg-surface rounded-t-xl flex justify-between items-start">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="material-symbols-outlined text-primary">shelves</span>
                        <h3 class="font-headline-lg text-headline-lg font-bold text-on-surface">Shelf A3</h3>
                    </div>
                    <p class="font-body-md text-on-surface-variant">Zone A • Level 1-3</p>
                </div>
            </div>
            <div class="flex-1 overflow-y-auto p-6 flex flex-col gap-6">
                <!-- Capacity Widget -->
                <div>
                    <div class="flex justify-between items-end mb-2">
                        <span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Current Capacity</span>
                        <span class="font-headline-md text-headline-md font-bold text-error">85%</span>
                    </div>
                    <div class="w-full bg-surface-container h-3 rounded-full overflow-hidden mb-2">
                        <div class="bg-primary-container h-full rounded-full w-[85%]"></div>
                    </div>
                </div>
                <!-- Stored Products List -->
                <div class="border-t border-outline-variant pt-6">
                    <h4 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-4">Products Stored (4)</h4>
                    <ul class="space-y-3">
                        <li class="bg-surface rounded-lg p-3 border border-outline-variant flex items-center justify-between group hover:border-primary-container transition-colors cursor-pointer">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded bg-secondary-container flex items-center justify-center text-on-secondary-container">
                                    <span class="material-symbols-outlined text-[20px]">monitor</span>
                                </div>
                                <div>
                                    <p class="font-body-md font-bold text-on-surface">LED Monitors 27"</p>
                                    <p class="font-data-mono text-data-mono text-on-surface-variant text-[12px]">SKU: MON-27-LED</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="font-body-md font-medium text-on-surface">45 units</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </aside>
    </div>
</div>
