                        <th class="py-3 px-4 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Dock</th>
                        <th class="py-3 px-4 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Nhà cung cấp</th>
                        <th class="py-3 px-4 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Mô tả hàng</th>
                        <th class="py-3 px-4 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider text-right">Pallet</th>
                        <th class="py-3 px-4 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider text-right">Số kiện</th>
                        <th class="py-3 px-4 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Khu vực</th>
                        <th class="py-3 px-4 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Trạng thái</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant bg-surface-container-lowest font-body-md text-body-md">
                    <tr class="hover:bg-surface-container-low transition-colors">
