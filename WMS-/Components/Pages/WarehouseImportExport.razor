        <!-- Summary footer -->
        <div class="bg-surface-container border-t border-outline-variant p-4 flex flex-wrap gap-6 items-center">
            <div class="flex items-center gap-2">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase">Tổng pallet:</span>
                <span class="font-data-mono text-data-mono text-on-surface font-bold">47</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase">Tổng kiện:</span>
                <span class="font-data-mono text-data-mono text-on-surface font-bold">1,785</span>
