                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="py-3 px-4 font-data-mono text-data-mono text-on-surface-variant">IMP-2024-0006</td>
                        <td class="py-3 px-4 font-data-mono text-data-mono text-on-surface-variant">SHP-DB-006</td>
                        <td class="py-3 px-4"><span class="inline-flex items-center px-2 py-0.5 rounded font-label-md text-label-md bg-secondary-fixed text-on-secondary-fixed-variant">Dock 2</span></td>
