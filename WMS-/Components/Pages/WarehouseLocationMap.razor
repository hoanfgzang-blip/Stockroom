@page "/warehouse-location-map"
@using WMS_.Data.Entities
@inject WMS_.Services.InventoryService InventoryService

<div class="space-y-gutter">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="font-display-lg text-display-lg text-on-background">Location Management</h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant mt-1">Interactive warehouse layout capacity tracker</p>
        </div>
        <div class="flex items-center gap-3">
            <!-- Legend -->
            <div class="hidden lg:flex items-center gap-2 px-4 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg shadow-sm">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase mr-2">Capacity fill:</span>
                <div class="w-4 h-4 rounded bg-[#d1fae5] border border-[#34d399]" title="0-20%"></div>
                <span class="text-xs text-on-surface-variant">0-20%</span>
                <div class="w-4 h-4 rounded bg-[#bfdbfe] border border-[#60a5fa]" title="21-60%"></div>
                <span class="text-xs text-on-surface-variant">21-60%</span>
                <div class="w-4 h-4 rounded bg-[#1d4ed8] border border-[#1e40af]" title="61-100%"></div>
                <span class="text-xs text-on-surface-variant">61-100%</span>
            </div>
        </div>
    </div>

    <!-- Main Layout: Grid + Sidebar -->
    <div class="flex flex-col xl:flex-row gap-gutter">
        <!-- Warehouse Map / Heatmap -->
        <div class="flex-1 bg-surface-container-lowest border border-outline-variant rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] flex flex-col overflow-hidden relative">
            <!-- Controls Bar -->
            <div class="p-4 border-b border-outline-variant bg-surface flex justify-between items-center z-10">
                <div class="flex gap-2">
                    <button class="px-3 py-1.5 @(activeZone == "Zone A" ? "bg-primary-container text-on-primary" : "bg-surface text-on-surface border border-outline-variant") rounded-md font-label-md text-label-md hover:bg-primary transition-colors" @onclick='() => ChangeZone("Zone A")'>Zone A</button>
                    <button class="px-3 py-1.5 @(activeZone == "Zone B" ? "bg-primary-container text-on-primary" : "bg-surface text-on-surface border border-outline-variant") rounded-md font-label-md text-label-md hover:bg-primary transition-colors" @onclick='() => ChangeZone("Zone B")'>Zone B</button>
                </div>
            </div>
            <!-- Interactive Grid Area -->
            <div class="flex-1 p-8 overflow-auto bg-[#f8fafc] relative min-h-[400px]">
                <div class="mb-12">
                    <h3 class="font-label-md text-label-md text-on-surface-variant mb-4 uppercase tracking-widest text-center border-b border-dashed border-outline-variant pb-2">@activeZone Rack layout</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-5 md:grid-cols-10 gap-3">
                        @if (locations != null)
                        {
                            @foreach (var loc in locations.Where(l => l.Zone == activeZone))
                            {
                                var fillPercent = (int)Math.Round((double)loc.CurrentCapacity / loc.MaxCapacity * 100);
                                var colorStyle = GetCapacityStyle(fillPercent);
                                var isSelected = selectedLocation?.LocationId == loc.LocationId;
                                <button class="h-20 rounded-md flex flex-col items-center justify-center cursor-pointer transition-all hover:scale-105 hover:shadow-md @colorStyle.Bg @colorStyle.Border @colorStyle.Text @(isSelected ? "ring-2 ring-primary ring-offset-2" : "")"
                                        @onclick="() => SelectLocation(loc)">
                                    <span class="font-headline-md font-bold">@loc.Shelf</span>
                                    <span class="font-label-md text-[10px] opacity-80">@fillPercent%</span>
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Detail Sidebar -->
        @if (selectedLocation != null)
        {
            <aside class="w-full xl:w-96 bg-surface-container-lowest border border-outline-variant rounded-xl shadow-[0_10px_20px_rgba(0,0,0,0.1)] flex flex-col h-auto">
                <!-- Header -->
                <div class="p-6 border-b border-outline-variant bg-surface rounded-t-xl flex justify-between items-start">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="material-symbols-outlined text-primary">shelves</span>
                            <h3 class="font-headline-lg text-headline-lg font-bold text-on-surface">@selectedLocation.Shelf</h3>
                        </div>
                        <p class="font-body-md text-on-surface-variant">@selectedLocation.Zone • Level @selectedLocation.Level</p>
                    </div>
                </div>
                <div class="flex-1 overflow-y-auto p-6 flex flex-col gap-6">
                    <!-- Capacity Widget -->
                    <div>
                        <div class="flex justify-between items-end mb-2">
                            <span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Current Capacity</span>
                            <span class="font-headline-md text-headline-md font-bold text-error">@selectedLocation.CurrentCapacity / @selectedLocation.MaxCapacity</span>
                        </div>
                        <div class="w-full bg-surface-container h-3 rounded-full overflow-hidden mb-2">
                            <div class="bg-primary-container h-full rounded-full" style="width: @((double)selectedLocation.CurrentCapacity / selectedLocation.MaxCapacity * 100)%"></div>
                        </div>
                    </div>
                    <!-- Stored Products List -->
                    <div class="border-t border-outline-variant pt-6">
                        <h4 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-4">Products Stored</h4>
                        <ul class="space-y-3">
                            @foreach (var inv in selectedLocationInventories)
                            {
                                <li class="bg-surface rounded-lg p-3 border border-outline-variant flex items-center justify-between group hover:border-primary-container transition-colors">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded bg-secondary-container flex items-center justify-center text-on-secondary-container">
                                            <span class="material-symbols-outlined text-[20px]">inventory_2</span>
                                        </div>
                                        <div>
                                            <p class="font-body-md font-bold text-on-surface">@inv.Product?.Name</p>
                                            <p class="font-data-mono text-data-mono text-on-surface-variant text-[12px]">SKU: @inv.Product?.Sku</p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <p class="font-body-md font-medium text-on-surface">@inv.Quantity units</p>
                                    </div>
                                </li>
                            }
                            @if (!selectedLocationInventories.Any())
                            {
                                <li class="text-center text-on-surface-variant text-sm py-4">No products currently stored here.</li>
                            }
                        </ul>
                    </div>
                </div>
            </aside>
        }
        else
        {
            <aside class="w-full xl:w-96 bg-surface-container-lowest border border-outline-variant rounded-xl p-6 flex flex-col justify-center items-center text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-[48px] mb-2 text-outline-variant">info</span>
                <p>Click on any shelf on the map to inspect stored items and location capacity details.</p>
            </aside>
        }
    </div>
</div>

@code {
    private List<Location> locations = new();
    private string activeZone = "Zone A";
    private Location? selectedLocation;
    private List<Inventory> selectedLocationInventories = new();

    protected override async Task OnInitializedAsync()
    {
        locations = await InventoryService.GetLocationsAsync();
        if (locations.Any())
        {
            await SelectLocation(locations.First());
        }
    }

    private void ChangeZone(string zone)
    {
        activeZone = zone;
        selectedLocation = locations.FirstOrDefault(l => l.Zone == zone);
        if (selectedLocation != null)
        {
            _ = SelectLocation(selectedLocation);
        }
    }

    private async Task SelectLocation(Location location)
    {
        selectedLocation = location;
        selectedLocationInventories = await InventoryService.GetInventoryByLocationAsync(location.LocationId);
    }

    private (string Bg, string Border, string Text) GetCapacityStyle(int fillPercent)
    {
        if (fillPercent <= 20)
        {
            return ("bg-[#d1fae5]", "border-[#34d399]", "text-[#065f46]");
        }
        if (fillPercent <= 60)
        {
            return ("bg-[#bfdbfe]", "border-[#60a5fa]", "text-[#1e3a8a]");
        }
        return ("bg-[#1d4ed8]", "border-[#1e40af]", "text-white");
    }
}
