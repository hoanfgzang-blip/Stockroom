                        <td class="py-3 px-4 text-on-surface-variant">Hàng chờ PL</td>
                        <td class="py-3 px-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800 border border-yellow-200">Chờ phân loại</span>
                        </td>
                    </tr>
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="py-3 px-4 font-data-mono text-data-mono text-on-surface-variant">IMP-2024-0004</td>
                        <td class="py-3 px-4 font-data-mono text-data-mono text-on-surface-variant">SHP-DD-004</td>
                        <td class="py-3 px-4"><span class="inline-flex items-center px-2 py-0.5 rounded font-label-md text-label-md bg-error-container text-on-error-container">Dock 4</span></td>
