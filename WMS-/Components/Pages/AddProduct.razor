@page "/add-product"

<div class="space-y-gutter">
    <!-- Task-Focused Header (Navigation Shell Suppressed) -->
    <header class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm flex items-center justify-between transition-shadow">
        <div class="flex items-center gap-4">
            <a href="product-management" class="text-on-surface-variant hover:bg-surface-container p-2 rounded-full transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
            </a>
            <div>
                <h1 class="font-headline-md text-headline-md md:font-headline-lg md:text-headline-lg text-on-surface">Add New Product</h1>
                <p class="font-body-md text-body-md text-on-surface-variant hidden md:block">Enter details to register a new SKU in the inventory.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="product-management" class="font-label-md text-label-md text-on-surface-variant border border-outline-variant hover:bg-surface-container-low px-[24px] py-[12px] rounded-lg transition-colors">
                Cancel
            </a>
            <button class="font-label-md text-label-md text-on-primary bg-primary-container hover:bg-primary px-[24px] py-[12px] rounded-lg shadow-sm transition-colors flex items-center gap-2" type="button">
                <span class="material-symbols-outlined text-[18px]">save</span>
                Save Product
            </button>
        </div>
    </header>

    <!-- Main Content Canvas -->
    <form class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
        <!-- Left Column: Logical Forms Cards -->
        <div class="lg:col-span-8 flex flex-col gap-gutter">
            <!-- Card 1: Basic Information -->
            <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm">
                <h2 class="font-headline-md text-headline-md text-on-surface mb-6 border-b border-outline-variant pb-4">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                    <!-- Product Name -->
                    <div class="md:col-span-2">
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="product_name">Product Name <span class="text-error">*</span></label>
                        <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface placeholder:text-on-surface-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="product_name" name="product_name" placeholder="e.g. DeWalt 20V Max Cordless Drill" required="" type="text"/>
                    </div>
                    <!-- SKU / Code -->
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="sku">SKU / Code <span class="text-error">*</span></label>
                        <div class="relative">
                            <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors font-data-mono text-data-mono" id="sku" name="sku" required="" type="text" value="DWT-20V-CD"/>
                        </div>
                    </div>
                    <!-- Barcode -->
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="barcode">Barcode (EAN/UPC)</label>
                        <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors font-data-mono text-data-mono" id="barcode" name="barcode" placeholder="e.g. 885911234567" type="text"/>
                    </div>
                    <!-- Category -->
                    <div class="md:col-span-2">
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="category">Category</label>
                        <div class="relative">
                            <select class="w-full appearance-none rounded-DEFAULT border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors pr-10" id="category" name="category">
                                <option disabled="" selected="" value="">Select a category...</option>
                                <option value="power_tools">Power Tools</option>
                                <option value="hand_tools">Hand Tools</option>
                                <option value="safety_gear">Safety Gear</option>
                                <option value="hardware">Hardware & Fasteners</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[20px]">expand_more</span>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Card 2: Warehouse Information -->
            <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm">
                <h2 class="font-headline-md text-headline-md text-on-surface mb-6 border-b border-outline-variant pb-4">Warehouse Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-5">
                    <!-- Current Quantity -->
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="qty">Initial Quantity</label>
                        <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors font-data-mono text-data-mono" id="qty" min="0" name="qty" type="number" value="0"/>
                    </div>
                    <!-- Shelf Location -->
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="location">Shelf Location</label>
                        <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface placeholder:text-on-surface-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors font-data-mono text-data-mono uppercase" id="location" name="location" placeholder="e.g. A1-04" type="text"/>
                    </div>
                    <!-- Min Stock Warning -->
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="min_stock">Min. Stock Warning</label>
                        <div class="relative">
                            <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors font-data-mono text-data-mono pl-9" id="min_stock" min="0" name="min_stock" type="number" value="10"/>
                            <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-tertiary text-[18px]">warning</span>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Card 3: Pricing -->
            <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm">
                <h2 class="font-headline-md text-headline-md text-on-surface mb-6 border-b border-outline-variant pb-4">Pricing Strategy</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                    <!-- Import Price -->
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="import_price">Import Price (Cost)</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant font-data-mono">$</span>
                            <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest pl-7 pr-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors font-data-mono text-data-mono" id="import_price" name="import_price" placeholder="0.00" step="0.01" type="number"/>
                        </div>
                    </div>
                    <!-- Selling Price -->
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="selling_price">Selling Price</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant font-data-mono">$</span>
                            <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest pl-7 pr-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors font-data-mono text-data-mono" id="selling_price" name="selling_price" placeholder="0.00" step="0.01" type="number"/>
                        </div>
                    </div>
                </div>
            </section>
        </div>
        <!-- Right Column: Product Image Upload -->
        <div class="lg:col-span-4">
            <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm sticky top-[100px]">
                <div class="flex items-center justify-between mb-6 border-b border-outline-variant pb-4">
                    <h2 class="font-headline-md text-headline-md text-on-surface">Product Image</h2>
                    <span class="material-symbols-outlined text-on-surface-variant">image</span>
                </div>
                <!-- Image Preview Area -->
                <div class="w-full aspect-square bg-surface-container border border-outline-variant rounded-lg overflow-hidden mb-4 relative group">
                    <!-- Preview Image -->
                    <div class="w-full h-full bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCRpbcuc2nRvrWdRVJcbEsAvix23Qkg3Ms5LaGrJ9F0SsueUD_HoIfBvUaiGbQWzk977CF4Qse81Nz9HRU_LSJTC9-Cr_GzRSLujkWf-1cnQYlO1A3z7-ivKfzD3u9rKvBJW_t_NjS7lEQ-rbRgOK4-STAbSj-I5D-XM27NMPpG7oT8hgb7KOYSC-HEoR6gST8R3jZxo6qjcdlyUOOgQknmoVS9o0lOeSmnK2sOBOX7gRYk5R8zuNGqRvCYuwHwvWzqtPKdx-N4epcK');">
                    </div>
                    <!-- Overlay Action -->
                    <div class="absolute inset-0 bg-inverse-surface/40 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                        <span class="material-symbols-outlined text-on-primary text-[32px] mb-2">cloud_upload</span>
                        <span class="font-label-md text-label-md text-on-primary">Replace Image</span>
                    </div>
                </div>
                <!-- Upload Controls -->
                <div class="flex flex-col gap-3">
                    <button class="w-full font-label-md text-label-md text-primary border border-primary hover:bg-primary/5 px-[24px] py-[10px] rounded-lg transition-colors flex items-center justify-center gap-2" type="button">
                        <span class="material-symbols-outlined text-[18px]">upload</span>
                        Upload New
                    </button>
                    <p class="font-label-md text-label-md text-on-surface-variant text-center opacity-70">
                        Supported formats: JPG, PNG, WEBP. Max size: 5MB.
                    </p>
                </div>
            </section>
        </div>
    </form>
</div>
