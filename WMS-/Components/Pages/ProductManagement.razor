@page "/product-management"
@using WMS_.Data.Entities
@inject WMS_.Services.InventoryService InventoryService

<div class="space-y-gutter">
    <!-- Page Header & Toolbar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-surface-container-lowest p-[16px] rounded-lg shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-outline-variant/30">
        <div>
            <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Products</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Manage inventory, prices, and stock levels.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <div class="relative w-full sm:w-64">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <span class="material-symbols-outlined text-outline">search</span>
                </div>
                <input class="block w-full pl-10 pr-3 py-2 border border-outline-variant rounded-md leading-5 bg-surface-container-lowest placeholder-outline focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary font-body-md text-body-md transition-shadow" placeholder="Search by SKU or name..." type="text" @bind="searchQuery" @bind:event="oninput"/>
            </div>
            <a href="add-product" class="inline-flex items-center px-[24px] py-[12px] border border-transparent rounded-md shadow-sm text-on-primary bg-primary-container hover:bg-primary focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary font-label-md text-label-md transition-colors">
                <span class="material-symbols-outlined mr-2 text-lg">add</span>
                Add Product
            </a>
        </div>
    </div>
    <!-- Data Table Card -->
    <div class="bg-surface-container-lowest rounded-lg shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-outline-variant/30 overflow-hidden flex flex-col">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-outline-variant/50">
                <thead class="bg-surface-container-low">
                    <tr>
                        <th class="px-6 py-3 text-left font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" scope="col">ID</th>
                        <th class="px-6 py-3 text-left font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" scope="col">Name</th>
                        <th class="px-6 py-3 text-left font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" scope="col">Description</th>
                        <th class="px-6 py-3 text-right font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" scope="col">Stock</th>
                        <th class="px-6 py-3 text-right font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" scope="col">Price</th>
                        <th class="px-6 py-3 text-center font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" scope="col">Status</th>
                        <th class="px-6 py-3 text-right font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-surface-container-lowest divide-y divide-outline-variant/30 font-body-md text-body-md">
                    @if (FilteredProducts != null && FilteredProducts.Any())
                    {
                        @foreach (var product in FilteredProducts)
                        {
                            var stock = GetStock(product.ProductId);
                            <tr class="hover:bg-surface-container-low transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap font-data-mono text-data-mono text-on-surface-variant">PRD-@product.ProductId</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="flex-shrink-0 h-10 w-10 bg-surface-container-high rounded border border-outline-variant/50 flex items-center justify-center overflow-hidden">
                                            <span class="material-symbols-outlined text-outline-variant text-xl">inventory_2</span>
                                        </div>
                                        <div class="ml-4">
                                            <div class="font-label-md text-label-md text-on-surface font-semibold">@product.Name</div>
                                            <div class="text-on-surface-variant text-xs mt-0.5">SKU: @product.Sku</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-on-surface-variant">@product.Description</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right font-data-mono text-data-mono @(stock < 100 ? (stock == 0 ? "text-error" : "text-tertiary") : "")">@stock</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right font-data-mono text-data-mono">$@product.UnitPrice.ToString("0.00")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    @if (stock == 0)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 border border-red-200">
                                            Out of Stock
                                        </span>
                                    }
                                    else if (stock < 100)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800 border border-yellow-200">
                                            Low Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">
                                            In Stock
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <button class="text-secondary hover:text-error transition-colors p-1" title="Delete" @onclick="() => DeleteProduct(product.ProductId)">
                                        <span class="material-symbols-outlined text-lg">delete</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-4 text-center text-on-surface-variant">No products found in inventory database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<Product> products = new();
    private List<Inventory> inventories = new();
    private string searchQuery = string.Empty;

    private IEnumerable<Product> FilteredProducts =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? products
            : products.Where(p => p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || 
                                  p.Sku.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        products = await InventoryService.GetProductsAsync();
        inventories = await InventoryService.GetInventoryAsync();
    }

    private int GetStock(int productId)
    {
        return inventories.Where(i => i.ProductId == productId).Sum(i => i.Quantity);
    }

    private async Task DeleteProduct(int productId)
    {
        await InventoryService.DeleteProductAsync(productId);
        await LoadProductsAsync();
    }
}
