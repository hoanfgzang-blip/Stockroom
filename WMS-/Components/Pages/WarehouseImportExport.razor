@page "/warehouse-import-export"

<div class="space-y-gutter">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background">New Import Transaction</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Record incoming stock from suppliers</p>
        </div>
        <div class="hidden sm:flex items-center gap-2 bg-surface-container-low px-3 py-1.5 rounded-md border border-outline-variant">
            <div class="w-2 h-2 rounded-full bg-primary"></div>
            <span class="font-data-mono text-data-mono text-on-surface-variant">TRX-90214-A</span>
        </div>
    </div>
    <!-- Meta Data Card -->
    <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm flex flex-col gap-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Supplier -->
            <div class="flex flex-col gap-2">
                <label class="font-label-md text-label-md text-on-surface-variant uppercase">Supplier</label>
                <div class="relative">
                    <select class="w-full appearance-none bg-surface border border-outline-variant rounded p-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
                        <option>Global Logistics Corp</option>
                        <option>Apex Manufacturing</option>
                        <option>Nolan Industrial</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant">arrow_drop_down</span>
                </div>
            </div>
            <!-- Employee -->
            <div class="flex flex-col gap-2">
                <label class="font-label-md text-label-md text-on-surface-variant uppercase">Responsible Employee</label>
                <div class="relative">
                    <input class="w-full bg-surface-container border border-outline-variant rounded p-3 font-body-md text-body-md text-on-surface-variant focus:outline-none cursor-not-allowed" readonly="" type="text" value="Jane Doe (ID: 4892)"/>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant">person</span>
                </div>
            </div>
            <!-- Date -->
            <div class="flex flex-col gap-2">
                <label class="font-label-md text-label-md text-on-surface-variant uppercase">Transaction Date</label>
                <div class="relative">
                    <input class="w-full bg-surface border border-outline-variant rounded p-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" type="date" value="2023-10-24"/>
                </div>
            </div>
        </div>
    </section>
    <!-- Main Transaction Area -->
    <section class="bg-surface-container-lowest border border-outline-variant rounded-lg shadow-sm flex flex-col overflow-hidden">
        <!-- Barcode Scanner Input -->
        <div class="p-4 border-b border-outline-variant bg-surface-container-low flex items-center gap-4">
            <div class="w-12 h-12 rounded bg-primary-container flex items-center justify-center text-on-primary shrink-0">
                <span class="material-symbols-outlined">barcode_scanner</span>
            </div>
            <div class="flex-1 relative">
                <input class="w-full bg-surface-container-lowest border border-outline-variant rounded p-3 pl-4 font-data-mono text-data-mono text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/50 transition-all placeholder:font-body-md placeholder:text-on-surface-variant text-lg" placeholder="Scan barcode or type SKU to add item..." type="text"/>
            </div>
        </div>
        <!-- Transaction Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[800px]">
                <thead>
                    <tr class="border-b border-outline-variant bg-surface">
                        <th class="py-3 px-6 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider w-1/2">Product</th>
                        <th class="py-3 px-6 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider w-1/6 text-right">Quantity</th>
                        <th class="py-3 px-6 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider w-1/6 text-right">Unit Price</th>
                        <th class="py-3 px-6 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider w-1/6 text-right">Total</th>
                        <th class="py-3 px-6 w-16"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant bg-surface-container-lowest">
                    <tr class="hover:bg-surface-container-low transition-colors group">
                        <td class="py-4 px-6">
                            <div class="flex flex-col">
                                <span class="font-body-md text-body-md text-on-surface font-semibold">Industrial Grade Ball Bearing</span>
                                <span class="font-data-mono text-data-mono text-on-surface-variant text-xs mt-1">SKU: BRG-7729-A</span>
                            </div>
                        </td>
                        <td class="py-4 px-6 text-right">
                            <input class="w-24 text-right bg-transparent border border-outline-variant rounded p-1.5 font-data-mono text-data-mono text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" type="number" value="250"/>
                        </td>
                        <td class="py-4 px-6 text-right font-data-mono text-data-mono text-on-surface">$12.50</td>
                        <td class="py-4 px-6 text-right font-data-mono text-data-mono text-on-surface font-medium">$3,125.00</td>
                        <td class="py-4 px-6 text-center">
                            <button class="text-on-surface-variant hover:text-error transition-colors opacity-0 group-hover:opacity-100 focus:opacity-100 p-1">
                                <span class="material-symbols-outlined text-[20px]">delete</span>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- Bottom Summary -->
        <div class="bg-surface-container border-t border-outline-variant p-6 flex flex-col md:flex-row justify-between items-end md:items-start">
            <div class="hidden md:block w-1/2">
                <div class="bg-surface-container-lowest border border-outline-variant rounded p-4">
                    <label class="font-label-md text-label-md text-on-surface-variant uppercase mb-2 block">Transaction Notes</label>
                    <textarea class="w-full bg-transparent border-none outline-none resize-none font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant p-0" placeholder="Add internal notes regarding this import..." rows="3"></textarea>
                </div>
            </div>
            <div class="w-full md:w-1/3 flex flex-col gap-3 min-w-[250px]">
                <div class="flex justify-between items-center">
                    <span class="font-body-md text-body-md text-on-surface-variant">Subtotal</span>
                    <span class="font-data-mono text-data-mono text-on-surface">$6,695.00</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="font-body-md text-body-md text-on-surface-variant">Tax (8%)</span>
                    <span class="font-data-mono text-data-mono text-on-surface">$535.60</span>
                </div>
                <div class="w-full h-px bg-outline-variant my-1"></div>
                <div class="flex justify-between items-center">
                    <span class="font-headline-md text-headline-md text-on-surface">Grand Total</span>
                    <span class="font-data-mono text-data-mono text-on-surface font-bold text-xl">$7,230.60</span>
                </div>
            </div>
        </div>
    </section>
    <!-- Footer Actions -->
    <div class="flex flex-col-reverse sm:flex-row justify-end items-center gap-4 mt-4 pb-8">
        <button class="w-full sm:w-auto px-6 py-3 rounded border border-outline-variant bg-surface text-on-surface font-label-md text-label-md flex items-center justify-center gap-2 hover:bg-surface-container transition-colors">
            <span class="material-symbols-outlined text-[18px]">print</span>
            Print Receipt
        </button>
        <button class="w-full sm:w-auto px-6 py-3 rounded border border-outline-variant bg-surface text-on-surface font-label-md text-label-md flex items-center justify-center gap-2 hover:bg-surface-container transition-colors">
            <span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
            Export PDF
        </button>
        <button class="w-full sm:w-auto px-8 py-3 rounded bg-primary text-on-primary font-label-md text-label-md flex items-center justify-center gap-2 hover:bg-primary-container transition-colors shadow-sm">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
            Process Transaction
        </button>
    </div>
</div>
