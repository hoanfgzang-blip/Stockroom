                        <td class="py-3 px-4 text-right font-data-mono text-data-mono text-on-surface">480</td>
                        <td class="py-3 px-4 text-on-surface-variant">Hàng chờ PL</td>
                        <td class="py-3 px-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-200">Đang dỡ hàng</span>
                        </td>
                    </tr>
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="py-3 px-4 font-data-mono text-data-mono text-on-surface-variant">IMP-2024-0003</td>
                        <td class="py-3 px-4 font-data-mono text-data-mono text-on-surface-variant">SHP-DC-003</td>
                        <td class="py-3 px-4"><span class="inline-flex items-center px-2 py-0.5 rounded font-label-md text-label-md bg-tertiary-fixed text-on-tertiary-fixed-variant">Dock 3</span></td>
                        <td class="py-3 px-4 text-on-surface">Viettel Post</td>
                        <td class="py-3 px-4 text-on-surface-variant">Bưu kiện liên tỉnh, hàng điện tử</td>
