                        <td class="py-3 px-4 text-on-surface-variant">Hàng nhập khẩu, tài liệu TM</td>
                        <td class="py-3 px-4 text-right font-data-mono text-data-mono text-on-surface">4</td>
                        <td class="py-3 px-4 text-right font-data-mono text-data-mono text-on-surface">95</td>
