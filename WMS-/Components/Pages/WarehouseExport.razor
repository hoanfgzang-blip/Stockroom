@page "/warehouse-export"

<div class="space-y-gutter">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background">Quản lý Xuất kho</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Xử lý và ghi nhận hàng hoá xuất kho</p>
        </div>
        <div class="hidden sm:flex items-center gap-2 bg-surface-container-low px-3 py-1.5 rounded-md border border-outline-variant">
            <div class="w-2 h-2 rounded-full bg-tertiary"></div>
            <span class="font-data-mono text-data-mono text-on-surface-variant">EXP-20214-B</span>
        </div>
    </div>

    <!-- Meta Data Card -->
    <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm flex flex-col gap-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Customer -->
            <div class="flex flex-col gap-2">
                <label class="font-label-md text-label-md text-on-surface-variant uppercase">Khách hàng</label>
                <div class="relative">
                    <select class="w-full appearance-none bg-surface border border-outline-variant rounded p-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
                        <option>Công ty TNHH Vận tải ABC</option>
                        <option>Công ty CP Giao nhận XYZ</option>
                        <option>Công ty Logistics Miền Nam</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant">arrow_drop_down</span>
                </div>
            </div>
            <!-- Employee -->
            <div class="flex flex-col gap-2">
                <label class="font-label-md text-label-md text-on-surface-variant uppercase">Nhân viên phụ trách</label>
                <div class="relative">
                    <input class="w-full bg-surface-container border border-outline-variant rounded p-3 font-body-md text-body-md text-on-surface-variant focus:outline-none cursor-not-allowed" readonly type="text" value="Nguyễn Văn A (ID: 2341)" />
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant">person</span>
                </div>
            </div>
            <!-- Date -->
            <div class="flex flex-col gap-2">
                <label class="font-label-md text-label-md text-on-surface-variant uppercase">Ngày xuất kho</label>
                <div class="relative">
                    <input class="w-full bg-surface border border-outline-variant rounded p-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" type="date" value="2023-10-24" />
                </div>
            </div>
        </div>
    </section>

    <!-- Main Transaction Area -->
    <section class="bg-surface-container-lowest border border-outline-variant rounded-lg shadow-sm flex flex-col overflow-hidden">
        <!-- Barcode Scanner Input -->
        <div class="p-4 border-b border-outline-variant bg-surface-container-low flex items-center gap-4">
            <div class="w-12 h-12 rounded bg-tertiary-fixed flex items-center justify-center text-on-tertiary shrink-0">
                <span class="material-symbols-outlined">barcode_scanner</span>
            </div>
            <div class="flex-1 relative">
                <input class="w-full bg-surface-container-lowest border border-outline-variant rounded p-3 pl-4 font-data-mono text-data-mono text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/50 transition-all placeholder:font-body-md placeholder:text-on-surface-variant text-lg" placeholder="Quét mã vạch hoặc nhập SKU để xuất hàng..." type="text" />
            </div>
        </div>
        <!-- Transaction Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[800px]">
                <thead>
                    <tr class="border-b border-outline-variant bg-surface">
                        <th class="py-3 px-6 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider w-1/2">Sản phẩm</th>
                        <th class="py-3 px-6 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider w-1/6 text-right">Số lượng</th>
                        <th class="py-3 px-6 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider w-1/6 text-right">Đơn giá</th>
                        <th class="py-3 px-6 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider w-1/6 text-right">Thành tiền</th>
                        <th class="py-3 px-6 w-16"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant bg-surface-container-lowest">
                    <tr class="hover:bg-surface-container-low transition-colors group">
                        <td class="py-4 px-6">
                            <div class="flex flex-col">
                                <span class="font-body-md text-body-md text-on-surface font-semibold">MacBook Pro M3</span>
                                <span class="font-data-mono text-data-mono text-on-surface-variant text-xs mt-1">SKU: MBP-M3-16</span>
                            </div>
                        </td>
                        <td class="py-4 px-6 text-right">
                            <input class="w-24 text-right bg-transparent border border-outline-variant rounded p-1.5 font-data-mono text-data-mono text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" type="number" value="5" />
                        </td>
                        <td class="py-4 px-6 text-right font-data-mono text-data-mono text-on-surface">$2,400.00</td>
                        <td class="py-4 px-6 text-right font-data-mono text-data-mono text-on-surface font-medium">$12,000.00</td>
                        <td class="py-4 px-6 text-center">
                            <button class="text-on-surface-variant hover:text-error transition-colors opacity-0 group-hover:opacity-100 focus:opacity-100 p-1">
                                <span class="material-symbols-outlined text-[20px]">delete</span>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- Bottom Summary -->
        <div class="bg-surface-container border-t border-outline-variant p-6 flex flex-col md:flex-row justify-between items-end md:items-start">
            <div class="hidden md:block w-1/2">
                <div class="bg-surface-container-lowest border border-outline-variant rounded p-4">
                    <label class="font-label-md text-label-md text-on-surface-variant uppercase mb-2 block">Ghi chú xuất kho</label>
                    <textarea class="w-full bg-transparent border-none outline-none resize-none font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant p-0" placeholder="Thêm ghi chú nội bộ cho phiếu xuất kho này..." rows="3"></textarea>
                </div>
            </div>
            <div class="w-full md:w-1/3 flex flex-col gap-3 min-w-[250px]">
                <div class="flex justify-between items-center">
                    <span class="font-body-md text-body-md text-on-surface-variant">Tạm tính</span>
                    <span class="font-data-mono text-data-mono text-on-surface">$12,000.00</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="font-body-md text-body-md text-on-surface-variant">Thuế (8%)</span>
                    <span class="font-data-mono text-data-mono text-on-surface">$960.00</span>
                </div>
                <div class="w-full h-px bg-outline-variant my-1"></div>
                <div class="flex justify-between items-center">
                    <span class="font-headline-md text-headline-md text-on-surface">Tổng cộng</span>
                    <span class="font-data-mono text-data-mono text-on-surface font-bold text-xl">$12,960.00</span>
                </div>
            </div>
        </div>
    </section>
    <!-- Footer Actions -->
    <div class="flex flex-col-reverse sm:flex-row justify-end items-center gap-4 mt-4 pb-8">
        <button class="w-full sm:w-auto px-6 py-3 rounded border border-outline-variant bg-surface text-on-surface font-label-md text-label-md flex items-center justify-center gap-2 hover:bg-surface-container transition-colors">
            <span class="material-symbols-outlined text-[18px]">print</span>
            In phiếu xuất
        </button>
        <button class="w-full sm:w-auto px-6 py-3 rounded border border-outline-variant bg-surface text-on-surface font-label-md text-label-md flex items-center justify-center gap-2 hover:bg-surface-container transition-colors">
            <span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
            Xuất PDF
        </button>
        <button class="w-full sm:w-auto px-8 py-3 rounded bg-tertiary-container text-on-tertiary font-label-md text-label-md flex items-center justify-center gap-2 hover:bg-tertiary transition-colors shadow-sm">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
            Xác nhận xuất kho
        </button>
    </div>
</div>
