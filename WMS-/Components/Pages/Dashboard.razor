@page "/dashboard"
@page "/"

<div class="flex flex-col gap-gutter">
    <!-- Page Header -->
    <div class="flex items-end justify-between">
        <div>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">Dashboard Overview</h2>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Real-time inventory and warehouse metrics.</p>
        </div>
        <button class="hidden md:flex items-center gap-2 px-4 py-2 bg-primary text-on-primary rounded-md font-label-md text-label-md hover:bg-primary-container transition-colors shadow-sm">
            <span class="material-symbols-outlined" style="font-size: 18px;">download</span>
            Export Report
        </button>
    </div>
    <!-- Top Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
        <!-- Stat Card 1 -->
        <div class="elevation-1 p-[16px] flex flex-col gap-3">
            <div class="flex justify-between items-start">
                <div class="p-2 bg-primary-fixed rounded-md text-primary">
                    <span class="material-symbols-outlined">inventory_2</span>
                </div>
                <span class="font-label-md text-label-md text-primary flex items-center gap-1 bg-primary-fixed/50 px-2 py-0.5 rounded-full">
                    <span class="material-symbols-outlined" style="font-size: 14px;">trending_up</span> +12%
                </span>
            </div>
            <div>
                <div class="font-body-md text-body-md text-on-surface-variant mb-1">Total Products</div>
                <div class="font-display-lg text-display-lg text-on-surface">2,540</div>
            </div>
        </div>
        <!-- Stat Card 2 -->
        <div class="elevation-1 p-[16px] flex flex-col gap-3 border-t-2 border-t-error">
            <div class="flex justify-between items-start">
                <div class="p-2 bg-error-container rounded-md text-error">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">warning</span>
                </div>
                <span class="font-label-md text-label-md text-error flex items-center gap-1 bg-error-container/50 px-2 py-0.5 rounded-full">
                    <span class="material-symbols-outlined" style="font-size: 14px;">arrow_downward</span> -3%
                </span>
            </div>
            <div>
                <div class="font-body-md text-body-md text-on-surface-variant mb-1">Low Stock Items</div>
                <div class="font-display-lg text-display-lg text-on-surface">12</div>
            </div>
        </div>
        <!-- Stat Card 3 -->
        <div class="elevation-1 p-[16px] flex flex-col gap-3">
            <div class="flex justify-between items-start">
                <div class="p-2 bg-secondary-fixed rounded-md text-on-secondary-fixed">
                    <span class="material-symbols-outlined">input</span>
                </div>
                <span class="font-label-md text-label-md text-primary flex items-center gap-1 bg-primary-fixed/50 px-2 py-0.5 rounded-full">
                    <span class="material-symbols-outlined" style="font-size: 14px;">trending_up</span> +8%
                </span>
            </div>
            <div>
                <div class="font-body-md text-body-md text-on-surface-variant mb-1">Items Imported Today</div>
                <div class="font-display-lg text-display-lg text-on-surface">145</div>
            </div>
        </div>
        <!-- Stat Card 4 -->
        <div class="elevation-1 p-[16px] flex flex-col gap-3">
            <div class="flex justify-between items-start">
                <div class="p-2 bg-tertiary-fixed rounded-md text-on-tertiary-fixed">
                    <span class="material-symbols-outlined">output</span>
                </div>
                <span class="font-label-md text-label-md text-on-surface-variant flex items-center gap-1 bg-surface-variant/50 px-2 py-0.5 rounded-full">
                    <span class="material-symbols-outlined" style="font-size: 14px;">horizontal_rule</span> 0%
                </span>
            </div>
            <div>
                <div class="font-body-md text-body-md text-on-surface-variant mb-1">Items Exported Today</div>
                <div class="font-display-lg text-display-lg text-on-surface">88</div>
            </div>
        </div>
        <!-- Stat Card 5 -->
        <div class="elevation-1 p-[16px] flex flex-col gap-3">
            <div class="flex justify-between items-start">
                <div class="p-2 bg-surface-container-highest rounded-md text-on-surface">
                    <span class="material-symbols-outlined">payments</span>
                </div>
                <span class="font-label-md text-label-md text-primary flex items-center gap-1 bg-primary-fixed/50 px-2 py-0.5 rounded-full">
                    <span class="material-symbols-outlined" style="font-size: 14px;">trending_up</span> +15%
                </span>
            </div>
            <div>
                <div class="font-body-md text-body-md text-on-surface-variant mb-1">Revenue This Month</div>
                <div class="font-headline-md text-headline-md text-on-surface mt-1">$124,500</div>
            </div>
        </div>
    </div>
    <!-- Bento Grid: Charts & Alerts -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
        <!-- Left Col: Charts (8 spans) -->
        <div class="lg:col-span-8 flex flex-col gap-gutter">
            <!-- Main Line Chart -->
            <div class="elevation-1 p-[24px] h-[320px] flex flex-col">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="font-headline-md text-headline-md text-on-surface">Import/Export Activity</h3>
                    <div class="flex gap-2">
                        <span class="flex items-center gap-1 font-label-md text-label-md text-on-surface-variant"><div class="w-2 h-2 rounded-full bg-primary"></div> Import</span>
                        <span class="flex items-center gap-1 font-label-md text-label-md text-on-surface-variant"><div class="w-2 h-2 rounded-full bg-tertiary"></div> Export</span>
                    </div>
                </div>
                <div class="flex-1 relative w-full border-b border-l border-outline-variant/30 flex items-end pt-4 pb-2">
                    <!-- Abstract line chart representation -->
                    <svg class="absolute bottom-0 w-full h-[80%] px-4" preserveaspectratio="none" viewbox="0 0 100 100">
                        <path d="M0,80 Q10,60 20,70 T40,40 T60,50 T80,20 T100,10 L100,100 L0,100 Z" fill="url(#grad1)" opacity="0.2"></path>
                        <path d="M0,80 Q10,60 20,70 T40,40 T60,50 T80,20 T100,10" fill="none" stroke="theme('colors.primary')" stroke-width="2"></path>
                        <path d="M0,90 Q15,85 30,60 T50,70 T70,40 T90,60 T100,50" fill="none" stroke="theme('colors.tertiary')" stroke-dasharray="4" stroke-width="2"></path>
                        <defs>
                            <lineargradient id="grad1" x1="0%" x2="0%" y1="0%" y2="100%">
                                <stop offset="0%" style="stop-color:theme('colors.primary');stop-opacity:1"></stop>
                                <stop offset="100%" style="stop-color:theme('colors.primary');stop-opacity:0"></stop>
                            </lineargradient>
                        </defs>
                    </svg>
                    <!-- Grid lines -->
                    <div class="absolute inset-0 flex flex-col justify-between pointer-events-none opacity-20">
                        <div class="w-full h-px bg-outline"></div>
                        <div class="w-full h-px bg-outline"></div>
                        <div class="w-full h-px bg-outline"></div>
                        <div class="w-full h-px bg-outline"></div>
                    </div>
                </div>
                <div class="flex justify-between font-label-md text-label-md text-outline mt-2 px-4">
                    <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                </div>
            </div>
            <!-- Sub Charts Row -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
                <!-- Bar Chart -->
                <div class="elevation-1 p-[20px] flex flex-col">
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Inventory by Category</h3>
                    <div class="flex-1 flex items-end gap-2 h-[150px] border-b border-outline-variant/30 pb-2">
                        <div class="w-full bg-primary rounded-t-sm h-[80%] hover:opacity-80 transition-opacity relative group"><div class="absolute -top-8 left-1/2 -translate-x-1/2 bg-inverse-surface text-inverse-on-surface font-label-md px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity">Electronics</div></div>
                        <div class="w-full bg-secondary-fixed rounded-t-sm h-[45%] hover:bg-secondary transition-colors"></div>
                        <div class="w-full bg-tertiary rounded-t-sm h-[60%] hover:opacity-80 transition-opacity"></div>
                        <div class="w-full bg-outline-variant rounded-t-sm h-[30%] hover:bg-outline transition-colors"></div>
                        <div class="w-full bg-primary-fixed rounded-t-sm h-[90%] hover:bg-primary transition-colors"></div>
                    </div>
                </div>
                <!-- Donut Chart -->
                <div class="elevation-1 p-[20px] flex flex-col items-center">
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-4 self-start">Top Selling</h3>
                    <div class="relative w-[150px] h-[150px] rounded-full border-[16px] border-surface-container flex items-center justify-center">
                        <!-- CSS Donut representation via conic gradient -->
                        <div class="absolute inset-[-16px] rounded-full" style="background: conic-gradient(theme('colors.primary') 0% 45%, theme('colors.secondary') 45% 75%, theme('colors.tertiary') 75% 100%); mask: radial-gradient(transparent 55%, black 56%); -webkit-mask: radial-gradient(transparent 55%, black 56%);"></div>
                        <div class="text-center z-10 bg-surface-container-lowest rounded-full w-[100px] h-[100px] flex flex-col items-center justify-center shadow-inner">
                            <span class="font-display-lg text-display-lg text-on-surface">45%</span>
                            <span class="font-label-md text-label-md text-on-surface-variant">Electronics</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Right Col: Alerts (4 spans) -->
        <div class="lg:col-span-4 flex flex-col">
            <div class="elevation-1 h-full flex flex-col overflow-hidden">
                <div class="p-4 border-b border-outline-variant bg-surface-container-lowest flex justify-between items-center">
                    <h3 class="font-headline-md text-headline-md text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-error">campaign</span> Critical Alerts
                    </h3>
                    <span class="bg-error text-on-error font-label-md px-2 py-0.5 rounded-full">3 New</span>
                </div>
                <div class="flex-1 overflow-y-auto p-2 flex flex-col gap-2">
                    <!-- Alert Item -->
                    <div class="p-3 rounded-md bg-error-container/20 border border-error/20 flex gap-3 items-start cursor-pointer hover:bg-error-container/40 transition-colors">
                        <div class="p-1.5 bg-error text-on-error rounded-full mt-0.5">
                            <span class="material-symbols-outlined" style="font-size: 16px;">error</span>
                        </div>
                        <div>
                            <h4 class="font-label-md text-label-md text-on-surface">SKU-492 is out of stock</h4>
                            <p class="font-body-md text-body-md text-on-surface-variant text-sm mt-1">High demand item requires immediate reorder from Supplier A.</p>
                            <span class="font-data-mono text-data-mono text-xs text-outline mt-2 block">10 mins ago</span>
                        </div>
                    </div>
                    <!-- Alert Item -->
                    <div class="p-3 rounded-md bg-tertiary-fixed/30 border border-tertiary/20 flex gap-3 items-start cursor-pointer hover:bg-tertiary-fixed/50 transition-colors">
                        <div class="p-1.5 bg-tertiary text-on-tertiary rounded-full mt-0.5">
                            <span class="material-symbols-outlined" style="font-size: 16px;">shelves</span>
                        </div>
                        <div>
                            <h4 class="font-label-md text-label-md text-on-surface">Shelf A3 reaching capacity</h4>
                            <p class="font-body-md text-body-md text-on-surface-variant text-sm mt-1">Zone A needs structural reorganization to accommodate incoming shipment.</p>
                            <span class="font-data-mono text-data-mono text-xs text-outline mt-2 block">1 hour ago</span>
                        </div>
                    </div>
                    <!-- Alert Item (Activity) -->
                    <div class="p-3 rounded-md bg-surface border border-outline-variant flex gap-3 items-start cursor-pointer hover:bg-surface-container transition-colors">
                        <div class="p-1.5 bg-secondary-fixed text-on-secondary-fixed rounded-full mt-0.5">
                            <span class="material-symbols-outlined" style="font-size: 16px;">history</span>
                        </div>
                        <div>
                            <h4 class="font-label-md text-label-md text-on-surface">Recent Warehouse Activity</h4>
                            <p class="font-body-md text-body-md text-on-surface-variant text-sm mt-1">User <span class="font-semibold text-primary">John Doe</span> imported 50 units of Solar Panels.</p>
                            <span class="font-data-mono text-data-mono text-xs text-outline mt-2 block">2 hours ago</span>
                        </div>
                    </div>
                </div>
                <div class="p-3 border-t border-outline-variant bg-surface text-center">
                    <a class="font-label-md text-label-md text-primary hover:underline" href="#">View All Notifications</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Recent Activity Table -->
    <div class="elevation-1 flex flex-col overflow-hidden">
        <div class="p-4 border-b border-outline-variant flex justify-between items-center bg-surface-container-lowest">
            <h3 class="font-headline-md text-headline-md text-on-surface">Recent Transactions</h3>
            <div class="flex gap-2">
                <button class="p-1.5 text-on-surface-variant hover:bg-surface-container rounded transition-colors"><span class="material-symbols-outlined" style="font-size: 20px;">filter_list</span></button>
                <button class="p-1.5 text-on-surface-variant hover:bg-surface-container rounded transition-colors"><span class="material-symbols-outlined" style="font-size: 20px;">more_vert</span></button>
            </div>
        </div>
        <div class="overflow-x-auto w-full">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface border-b border-outline-variant text-on-surface-variant font-label-md text-label-md">
                        <th class="py-3 px-4 font-semibold w-1/3">Product Name</th>
                        <th class="py-3 px-4 font-semibold">Action</th>
                        <th class="py-3 px-4 font-semibold">Employee</th>
                        <th class="py-3 px-4 font-semibold text-right">Date/Time</th>
                    </tr>
                </thead>
                <tbody class="font-body-md text-body-md text-on-surface">
                    <tr class="border-b border-outline-variant/50 hover:bg-surface-container-lowest/50 transition-colors group cursor-pointer">
                        <td class="py-3 px-4 flex items-center gap-3">
                            <div class="w-8 h-8 rounded bg-surface-container flex items-center justify-center text-outline group-hover:text-primary transition-colors">
                                <span class="material-symbols-outlined" style="font-size: 18px;">laptop_mac</span>
                            </div>
                            <span class="font-medium">MacBook Pro M3</span>
                        </td>
                        <td class="py-3 px-4">
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-tertiary-fixed text-on-tertiary-fixed-variant border border-tertiary/20">
                                <span class="material-symbols-outlined" style="font-size: 12px;">output</span> Export
                            </span>
                        </td>
                        <td class="py-3 px-4 flex items-center gap-2">
                            <div class="w-6 h-6 rounded-full bg-secondary text-on-secondary flex items-center justify-center text-xs font-bold">SS</div>
                            Sarah Smith
                        </td>
                        <td class="py-3 px-4 text-right font-data-mono text-data-mono text-on-surface-variant">Oct 24, 10:30 AM</td>
                    </tr>
                    <tr class="border-b border-outline-variant/50 hover:bg-surface-container-lowest/50 transition-colors group cursor-pointer">
                        <td class="py-3 px-4 flex items-center gap-3">
                            <div class="w-8 h-8 rounded bg-surface-container flex items-center justify-center text-outline group-hover:text-primary transition-colors">
                                <span class="material-symbols-outlined" style="font-size: 18px;">solar_power</span>
                            </div>
                            <span class="font-medium">Solar Panel 400W</span>
                        </td>
                        <td class="py-3 px-4">
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-primary-fixed text-on-primary-fixed-variant border border-primary/20">
                                <span class="material-symbols-outlined" style="font-size: 12px;">input</span> Import
                            </span>
                        </td>
                        <td class="py-3 px-4 flex items-center gap-2">
                            <div class="w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center text-xs font-bold">JD</div>
                            John Doe
                        </td>
                        <td class="py-3 px-4 text-right font-data-mono text-data-mono text-on-surface-variant">Oct 24, 09:15 AM</td>
                    </tr>
                    <tr class="border-b border-outline-variant/50 hover:bg-surface-container-lowest/50 transition-colors group cursor-pointer">
                        <td class="py-3 px-4 flex items-center gap-3">
                            <div class="w-8 h-8 rounded bg-surface-container flex items-center justify-center text-outline group-hover:text-primary transition-colors">
                                <span class="material-symbols-outlined" style="font-size: 18px;">chair</span>
                            </div>
                            <span class="font-medium">Ergonomic Chair</span>
                        </td>
                        <td class="py-3 px-4">
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-primary-fixed text-on-primary-fixed-variant border border-primary/20">
                                <span class="material-symbols-outlined" style="font-size: 12px;">input</span> Import
                            </span>
                        </td>
                        <td class="py-3 px-4 flex items-center gap-2">
                            <div class="w-6 h-6 rounded-full bg-secondary text-on-secondary flex items-center justify-center text-xs font-bold">MR</div>
                            Mike Ross
                        </td>
                        <td class="py-3 px-4 text-right font-data-mono text-data-mono text-on-surface-variant">Oct 23, 04:45 PM</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
