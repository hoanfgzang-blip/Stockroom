@page "/warehouse-import-export"

<div class="space-y-gutter">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background">Quản lý Nhập kho</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Kiểm đếm hàng chờ phân loại &amp; tiếp nhận dỡ hàng từ Dock 1 đến Dock 4</p>
        </div>
        <div class="hidden sm:flex items-center gap-2 bg-surface-container-low px-3 py-1.5 rounded-md border border-outline-variant">
            <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
            <span class="font-data-mono text-data-mono text-on-surface-variant">IMP-2024-LIVE</span>
        </div>
    </div>

    <!-- Dock Status Overview -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Dock 1 -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 flex flex-col gap-2 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase">Dock 1</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">Hoạt động</span>
            </div>
            <div class="font-display-lg text-display-lg text-on-surface">10</div>
            <div class="font-body-md text-body-md text-on-surface-variant">pallet đang dỡ</div>
            <div class="text-xs font-data-mono text-on-surface-variant">J&amp;T Express Vietnam</div>
        </div>
        <!-- Dock 2 -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 flex flex-col gap-2 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase">Dock 2</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">Hoạt động</span>
            </div>
            <div class="font-display-lg text-display-lg text-on-surface">12</div>
            <div class="font-body-md text-body-md text-on-surface-variant">pallet đang dỡ</div>
            <div class="text-xs font-data-mono text-on-surface-variant">Giao Hàng Nhanh (GHN)</div>
        </div>
        <!-- Dock 3 -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 flex flex-col gap-2 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase">Dock 3</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800 border border-yellow-200">Chờ phân loại</span>
            </div>
            <div class="font-display-lg text-display-lg text-on-surface">6</div>
            <div class="font-body-md text-body-md text-on-surface-variant">pallet chờ PL</div>
            <div class="text-xs font-data-mono text-on-surface-variant">Viettel Post</div>
        </div>
        <!-- Dock 4 -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 flex flex-col gap-2 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase">Dock 4</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800 border border-yellow-200">Chờ phân loại</span>
            </div>
            <div class="font-display-lg text-display-lg text-on-surface">4</div>
            <div class="font-body-md text-body-md text-on-surface-variant">pallet chờ PL</div>
            <div class="text-xs font-data-mono text-on-surface-variant">DHL Express</div>
        </div>
    </div>

    <!-- Barcode Scanner Input -->
    <section class="bg-surface-container-lowest border border-outline-variant rounded-lg shadow-sm flex flex-col overflow-hidden">
        <div class="p-4 border-b border-outline-variant bg-surface-container-low flex items-center gap-4">
            <div class="w-12 h-12 rounded bg-primary-container flex items-center justify-center text-on-primary shrink-0">
                <span class="material-symbols-outlined">barcode_scanner</span>
            </div>
            <div class="flex-1 relative">
                <input class="w-full bg-surface-container-lowest border border-outline-variant rounded p-3 pl-4 font-data-mono text-data-mono text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/50 transition-all placeholder:font-body-md placeholder:text-on-surface-variant text-lg"
                       placeholder="Quét mã vạch hoặc nhập SKU kiện hàng để kiểm đếm..."
                       type="text" />
            </div>
            <div class="flex gap-2">
                <select class="appearance-none bg-surface border border-outline-variant rounded px-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary transition-all">
                    <option>Dock 1</option>
                    <option>Dock 2</option>
                    <option>Dock 3</option>
                    <option>Dock 4</option>
                </select>
            </div>
        </div>

        <!-- Import Table — dữ liệu từ /wwwroot/Assets/data/importData.js -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[900px]">
