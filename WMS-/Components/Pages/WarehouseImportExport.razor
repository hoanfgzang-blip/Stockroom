                        <td class="py-3 px-4 text-right font-data-mono text-data-mono text-on-surface">7</td>
                        <td class="py-3 px-4 text-right font-data-mono text-data-mono text-on-surface">280</td>
                        <td class="py-3 px-4 text-on-surface-variant">Khu phân loại</td>
                        <td class="py-3 px-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">Hoàn thành</span>
