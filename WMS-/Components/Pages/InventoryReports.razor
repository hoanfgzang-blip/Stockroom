@page "/inventory-reports"

<div class="space-y-gutter">
    <!-- Page Header & Global Actions -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-2">
        <div>
            <h1 class="font-display-lg text-display-lg text-on-surface">Advanced Analytics</h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant mt-2 max-w-2xl">Comprehensive view of operational performance, financial health, and supply chain efficiency.</p>
        </div>
        <!-- Export Section -->
        <div class="flex items-center gap-4 flex-shrink-0">
            <button class="flex items-center gap-2 px-6 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-on-surface font-label-md text-label-md hover:bg-surface-container-low hover:border-outline transition-all shadow-sm">
                <span class="material-symbols-outlined icon-md">picture_as_pdf</span>
                Generate PDF
            </button>
            <button class="flex items-center gap-2 px-6 py-3 bg-primary-container text-on-primary rounded-lg font-label-md text-label-md hover:bg-primary transition-colors shadow-sm">
                <span class="material-symbols-outlined icon-md">download</span>
                Download Excel
            </button>
        </div>
    </div>
    <!-- Top Filters Bar -->
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 flex flex-wrap items-center gap-4 shadow-sm">
        <div class="flex items-center gap-2 text-on-surface-variant font-label-md text-label-md mr-2">
            <span class="material-symbols-outlined icon-md">filter_list</span>
            FILTERS
        </div>
        <!-- Filter: Date Range -->
        <div class="relative">
            <select class="appearance-none bg-surface-container-lowest border border-outline-variant rounded-lg pl-4 pr-10 py-2 font-body-md text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none cursor-pointer hover:border-outline transition-colors min-w-[160px]">
                <option>Last 30 Days</option>
                <option>This Quarter</option>
                <option>Year to Date</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant icon-lg">expand_more</span>
        </div>
        <!-- Filter: Employee -->
        <div class="relative">
            <select class="appearance-none bg-surface-container-lowest border border-outline-variant rounded-lg pl-4 pr-10 py-2 font-body-md text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none cursor-pointer hover:border-outline transition-colors min-w-[140px]">
                <option>Employee (All)</option>
                <option>Shift A</option>
                <option>Shift B</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant icon-lg">expand_more</span>
        </div>
        <!-- Filter: Category -->
        <div class="relative">
            <select class="appearance-none bg-surface-container-lowest border border-outline-variant rounded-lg pl-4 pr-10 py-2 font-body-md text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none cursor-pointer hover:border-outline transition-colors min-w-[160px]">
                <option>Category: Electronics</option>
                <option>Category: Apparel</option>
                <option>Category: Hardware</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant icon-lg">expand_more</span>
        </div>
        <div class="flex-1"></div>
        <button class="text-primary font-label-md text-label-md hover:underline flex items-center gap-1">
            <span class="material-symbols-outlined icon-sm">refresh</span> Reset
        </button>
    </div>
    <!-- KPI Cards Grid (4 Columns) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
        <!-- KPI 1 -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-5 flex flex-col justify-between relative overflow-hidden group shadow-sm">
            <div class="absolute top-0 left-0 w-full h-1 bg-primary"></div>
            <div class="flex justify-between items-start mb-4">
                <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wide">Inventory Turnover Rate</p>
                <span class="material-symbols-outlined text-outline-variant">sync</span>
            </div>
            <div>
                <div class="font-display-lg text-display-lg text-on-surface">8.4x</div>
                <div class="flex items-center gap-1 mt-2">
                    <span class="material-symbols-outlined icon-filled icon-sm text-primary">trending_up</span>
                    <span class="font-label-md text-label-md text-primary">+1.2x vs last month</span>
                </div>
            </div>
        </div>
        <!-- KPI 2 -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-5 flex flex-col justify-between relative overflow-hidden group shadow-sm">
            <div class="absolute top-0 left-0 w-full h-1 bg-surface-tint"></div>
            <div class="flex justify-between items-start mb-4">
                <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wide">Average Fulfillment Time</p>
                <span class="material-symbols-outlined text-outline-variant">timer</span>
            </div>
            <div>
                <div class="font-display-lg text-display-lg text-on-surface">1.2<span class="text-headline-md font-normal text-on-surface-variant ml-1">hrs</span></div>
                <div class="flex items-center gap-1 mt-2">
                    <span class="material-symbols-outlined icon-filled icon-sm text-primary">trending_down</span>
                    <span class="font-label-md text-label-md text-primary">-15 min improvement</span>
                </div>
            </div>
        </div>
        <!-- KPI 3 -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-5 flex flex-col justify-between relative overflow-hidden group shadow-sm">
            <div class="absolute top-0 left-0 w-full h-1 bg-error"></div>
            <div class="flex justify-between items-start mb-4">
                <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wide">Return Rate</p>
                <span class="material-symbols-outlined text-outline-variant">assignment_return</span>
            </div>
            <div>
                <div class="font-display-lg text-display-lg text-on-surface">2.8%</div>
                <div class="flex items-center gap-1 mt-2">
                    <span class="material-symbols-outlined icon-filled icon-sm text-error">trending_up</span>
                    <span class="font-label-md text-label-md text-error">+0.4% concern</span>
                </div>
            </div>
        </div>
        <!-- KPI 4 -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-5 flex flex-col justify-between relative overflow-hidden group shadow-sm">
            <div class="absolute top-0 left-0 w-full h-1 bg-tertiary"></div>
            <div class="flex justify-between items-start mb-4">
                <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wide">Total Waste / Loss</p>
                <span class="material-symbols-outlined text-outline-variant">delete_sweep</span>
            </div>
            <div>
                <div class="font-display-lg text-display-lg text-on-surface">$4.2k</div>
                <div class="flex items-center gap-1 mt-2 text-on-surface-variant">
                    <span class="material-symbols-outlined icon-sm">horizontal_rule</span>
                    <span class="font-label-md text-label-md">Stable trend</span>
                </div>
            </div>
        </div>
    </div>
    <!-- Main Visuals -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter mb-8">
        <!-- Revenue vs Expenses -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg col-span-1 lg:col-span-12 p-6 h-[400px] flex flex-col shadow-sm">
            <div class="flex justify-between items-center mb-6">
                <h3 class="font-headline-md text-headline-md text-on-surface">Revenue vs. Expenses</h3>
                <button class="p-1.5 rounded hover:bg-surface-container transition-colors text-on-surface-variant">
                    <span class="material-symbols-outlined">more_vert</span>
                </button>
            </div>
            <div class="flex-1 relative flex items-end pt-8 pb-6 px-4">
                <div class="absolute left-0 top-0 h-full flex flex-col justify-between text-on-surface-variant font-data-mono text-data-mono pb-6 pr-4 border-r border-outline-variant bg-surface-container-lowest z-10 w-16 text-right">
                    <span>$50k</span>
                    <span>$40k</span>
                    <span>$30k</span>
                    <span>$20k</span>
                    <span>$10k</span>
                    <span>$0</span>
                </div>
                <div class="absolute left-16 right-4 top-8 bottom-6 flex flex-col justify-between pointer-events-none">
                    <div class="w-full h-px bg-surface-variant"></div>
                    <div class="w-full h-px bg-surface-variant"></div>
                    <div class="w-full h-px bg-surface-variant"></div>
                    <div class="w-full h-px bg-surface-variant"></div>
                    <div class="w-full h-px bg-surface-variant"></div>
                    <div class="w-full h-px border-b-2 border-outline-variant"></div>
                </div>
                <div class="relative w-full h-full ml-16 flex items-end justify-between px-4">
                    <div class="absolute bottom-0 left-0 w-full h-[60%] bg-gradient-to-t from-primary-fixed-dim/20 to-transparent rounded-t-lg"></div>
                    <div class="absolute bottom-0 left-0 w-full h-[40%] bg-gradient-to-t from-error-container/10 to-transparent rounded-t-lg"></div>
                </div>
                <div class="absolute bottom-0 left-16 right-4 flex justify-between px-4 text-on-surface-variant font-data-mono text-data-mono mt-2">
                    <span>Week 1</span>
                    <span>Week 2</span>
                    <span>Week 3</span>
                    <span>Week 4</span>
                    <span>Current</span>
                </div>
            </div>
            <div class="flex justify-center gap-6 mt-4 border-t border-surface-variant pt-4">
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-primary"></span>
                    <span class="font-label-md text-label-md text-on-surface">Revenue</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-error"></span>
                    <span class="font-label-md text-label-md text-on-surface">Expenses</span>
                </div>
            </div>
        </div>
    </div>
</div>
