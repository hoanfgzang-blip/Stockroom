            <div class="ml-auto flex gap-3">
                <button class="px-4 py-2 rounded border border-outline-variant bg-surface text-on-surface font-label-md text-label-md flex items-center gap-2 hover:bg-surface-container transition-colors">
                    <span class="material-symbols-outlined icon-md">download</span>
                    Xuất Excel
                </button>
                <button class="px-4 py-2 rounded bg-primary text-on-primary font-label-md text-label-md flex items-center gap-2 hover:bg-primary-container transition-colors shadow-sm">
                    <span class="material-symbols-outlined icon-md">check_circle</span>
                    Xác nhận nhập kho
                </button>
            </div>
        </div>
