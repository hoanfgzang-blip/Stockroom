eft-2.5 top-1/2 -translate-y-1/2 text-tertiary text-[18px]\">warning</span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <!-- Card 3: Pricing -->\n            <section class=\"bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm\">\n                <h2 class=\"font-headline-md text-headline-md text-on-surface mb-6 border-b border-outline-variant pb-4\">Pricing Strategy</h2>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5\">\n                    <!-- Import Price -->\n                    <div>\n                        <label class=\"block font-label-md text-label-md text-on-surface-variant mb-1\" for=\"import_price\">Import Price (Cost)</label>\n                        <div class=\"relative\">\n                            <span class=\"absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant font-data-mono\">$</span>\n                            <input class=\"w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest pl-7 pr-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors font-data-mono text-data-mono\" id=\"import_price\" name=\"import_price\" placeholder=\"0.00\" step=\"0.01\" type=\"number\"/>\n                        </div>\n                    </div>\n                    <!-- Selling Price -->\n                    <div>\n                        <label class=\"block font-label-md text-label-md text-on-surface-variant mb-1\" for=\"selling_price\">Selling Price</label>\n                        <div class=\"relative\">\n                            <span class=\"absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant font-data-mono\">$</span>\n                            <input class=\"w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest pl-7 pr-3 py-2 text-body-md text-on-surface focus:border-pr