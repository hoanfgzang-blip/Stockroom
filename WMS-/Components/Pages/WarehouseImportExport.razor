                        <td class="py-3 px-4 font-data-mono text-data-mono text-on-surface-variant">SHP-DA-001</td>
                        <td class="py-3 px-4"><span class="inline-flex items-center px-2 py-0.5 rounded font-label-md text-label-md bg-primary-fixed text-on-primary-fixed-variant">Dock 1</span></td>
