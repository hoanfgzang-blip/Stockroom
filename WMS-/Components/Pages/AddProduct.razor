@page "/add-product"
@using WMS_.Data.Entities
@inject WMS_.Services.InventoryService InventoryService
@inject NavigationManager NavigationManager

<div class="space-y-gutter">
    <!-- Task-Focused Header -->
    <header class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm flex items-center justify-between transition-shadow">
        <div class="flex items-center gap-4">
            <a href="product-management" class="text-on-surface-variant hover:bg-surface-container p-2 rounded-full transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined icon-lg">arrow_back</span>
            </a>
            <div>
                <h1 class="font-headline-md text-headline-md md:font-headline-lg md:text-headline-lg text-on-surface">Add New Product</h1>
                <p class="font-body-md text-body-md text-on-surface-variant hidden md:block">Enter details to register a new SKU in the WMS database.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="product-management" class="font-label-md text-label-md text-on-surface-variant border border-outline-variant hover:bg-surface-container-low px-[24px] py-[12px] rounded-lg transition-colors">
                Cancel
            </a>
            <button class="font-label-md text-label-md text-on-primary bg-primary-container hover:bg-primary px-[24px] py-[12px] rounded-lg shadow-sm transition-colors flex items-center gap-2" type="button" @onclick="SaveProduct">
                <span class="material-symbols-outlined icon-md">save</span>
                Save Product
            </button>
        </div>
    </header>

    <!-- Main Content Canvas -->
    <form class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start" @submit:preventDefault>
        <!-- Left Column -->
        <div class="lg:col-span-8 flex flex-col gap-gutter">
            <!-- Card 1: Basic Information -->
            <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm">
                <h2 class="font-headline-md text-headline-md text-on-surface mb-6 border-b border-outline-variant pb-4">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                    <!-- Product Name -->
                    <div class="md:col-span-2">
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="product_name">Product Name <span class="text-error">*</span></label>
                        <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface placeholder:text-on-surface-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="product_name" placeholder="e.g. DeWalt 20V Max Cordless Drill" required="" type="text" @bind="productName"/>
                    </div>
                    <!-- SKU / Code -->
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="sku">SKU / Code <span class="text-error">*</span></label>
                        <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors font-data-mono text-data-mono" id="sku" required="" type="text" @bind="sku"/>
                    </div>
                    <!-- Barcode -->
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="barcode">Barcode (EAN/UPC)</label>
                        <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors font-data-mono text-data-mono" id="barcode" placeholder="e.g. 885911234567" type="text" @bind="barcode"/>
                    </div>
                    <!-- Description -->
                    <div class="md:col-span-2">
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="description">Description</label>
                        <textarea class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="description" placeholder="Describe this item..." rows="3" @bind="description"></textarea>
                    </div>
                </div>
            </section>
            <!-- Card 2: Pricing -->
            <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm">
                <h2 class="font-headline-md text-headline-md text-on-surface mb-6 border-b border-outline-variant pb-4">Pricing Strategy</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                    <!-- Selling Price -->
                    <div class="md:col-span-2">
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1" for="selling_price">Selling Price</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant font-data-mono">$</span>
                            <input class="w-full rounded-DEFAULT border border-outline-variant bg-surface-container-lowest pl-7 pr-3 py-2 text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors font-data-mono text-data-mono" id="selling_price" placeholder="0.00" step="0.01" type="number" @bind="sellingPrice"/>
                        </div>
                    </div>
                </div>
            </section>
        </div>
        <!-- Right Column -->
        <div class="lg:col-span-4">
            <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm sticky top-[100px]">
                <div class="flex items-center justify-between mb-6 border-b border-outline-variant pb-4">
                    <h2 class="font-headline-md text-headline-md text-on-surface">Product Image</h2>
                    <span class="material-symbols-outlined text-on-surface-variant">image</span>
                </div>
                <!-- Image Preview Area -->
                <div class="w-full aspect-square bg-surface-container border border-outline-variant rounded-lg overflow-hidden mb-4 relative flex items-center justify-center">
                    <span class="material-symbols-outlined text-outline-variant icon-2xl">inventory_2</span>
                </div>
            </section>
        </div>
    </form>
</div>

@code {
    private string productName = string.Empty;
    private string sku = string.Empty;
    private string barcode = string.Empty;
    private string description = string.Empty;
    private decimal sellingPrice = 0.00m;

    private async Task SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(productName) || string.IsNullOrWhiteSpace(sku))
        {
            return;
        }

        var newProduct = new Product
        {
            Name = productName,
            Sku = sku,
            Barcode = string.IsNullOrWhiteSpace(barcode) ? sku : barcode,
            Description = description,
            UnitPrice = sellingPrice
        };

        await InventoryService.AddProductAsync(newProduct);
        NavigationManager.NavigateTo("product-management");
    }
}
